SCAN_TRUSTED_SEARCH_ENRICHMENT_ENABLED=true
SCAN_TRUSTED_SEARCH_PAGE_SIZE=6
SCAN_TRUSTED_SEARCH_MIN_MATCH_SCORE=80
SCAN_AI_CATALOG_ENRICHMENT_ENABLED=true
SCAN_AI_CATALOG_ENRICHMENT_CACHE_TTL=10080
SCAN_AI_CATALOG_IMAGE_TIMEOUT=8
