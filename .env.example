OPENFOODFACTS_RETRY_ATTEMPTS=3
SCAN_MIN_CANDIDATE_CONFIDENCE=45
SCAN_PERFECT_SCORE_CAP=95
SCAN_SPARSE_FOOD_SCORE_CAP=65
SCAN_SPARSE_COSMETIC_SCORE_CAP=55
SCAN_WATER_PLASTIC_SCORE_CAP=89
SCAN_STALE_AFTER_DAYS=30
GOOGLE_CLOUD_VISION_BASE_URL=https://vision.googleapis.com/v1
GOOGLE_CLOUD_TOKEN_URL=https://oauth2.googleapis.com/token
