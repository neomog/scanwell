OPENAI_RETRY_ATTEMPTS=1
OPENAI_IMAGE_RECOGNITION_MODEL=gpt-5.4-mini
OPENAI_INGREDIENT_EXTRACTION_MODEL=gpt-5.4-mini
OPENAI_NUTRITION_EXTRACTION_MODEL=gpt-5.4-mini
OPENAI_BARCODE_WEB_SEARCH_ENABLED=true
