GOOGLE_CLOUD_VISION_CREDENTIALS_JSON=
GOOGLE_CLOUD_VISION_TIMEOUT=30
GOOGLE_CLOUD_VISION_RETRY_ATTEMPTS=1
OPENAI_API_KEY=
