GOOGLE_CLOUD_VISION_CREDENTIALS_JSON=
GOOGLE_CLOUD_VISION_TIMEOUT=30

# Billing
SUBSCRIPTIONS_DEFAULT_PLAN=free
SUBSCRIPTIONS_CURRENCY=usd
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
